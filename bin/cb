#!/usr/bin/env python3
"""cb: name, find, message and watch agent sessions across the WSL box and the Mac.

  cb register <label> --scope "<what this session handles>" [--session <agent session id>]
  cb unregister [<label>]          (default: this terminal's entry)
  cb who [--json]                  roster + live state on both machines
  cb send <label> <message...>     refuses unknown labels and dead terminals; never guesses.
                                   Empty input box: sent now. Someone typing there (terminal
                                   or Orca's compose box), a menu open, or Codex mid-turn:
                                   queued, and sent in order once the box is empty again.
                                   Nothing is dropped and no Enter lands on a person's text.
  cb queue [--drop <id>]           what is waiting for each session, and why
  cb board [--port 8765]           live HTML dashboard (run on the WSL box)

Labels are <machine>/<scope>, e.g. mac01/merger, wsl01/liaison. Each session is one
JSON file in the registry dir; when that dir is a git checkout it is pulled and pushed, so
two machines never edit the same file. Liveness and screens are read live through Orca.
Config: ~/.config/maestro/cb.json (or $CB_CONFIG), all keys optional:
  machine   this machine's name (default: short hostname)
  registry  dir of session JSON files (default: ~/.config/maestro/registry)
  remotes   {"<machine>": "<orca environment name>"} for every other machine
  prs_repo  "owner/repo" whose open PRs the board shows
  runs      {"<machine>": "<dir of run manifests>"} for the board's runs panel
"""

from __future__ import annotations

import argparse
import fcntl
import glob
import html
import json
import os
import platform
import re
import secrets
import secrets
import shutil
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

try:
    CFG = json.loads(Path(os.environ.get("CB_CONFIG") or Path.home() / ".config" / "maestro" / "cb.json").read_text())
except (OSError, ValueError):
    CFG = {}
IS_MAC = platform.system() == "Darwin"
MACHINE = os.environ.get("CB_MACHINE") or CFG.get("machine") or platform.node().split(".")[0].lower()
REG = Path(os.environ.get("CB_REGISTRY") or CFG.get("registry") or Path.home() / ".config" / "maestro" / "registry").expanduser()
REMOTES: dict[str, str] = CFG.get("remotes", {})  # other machine -> its Orca environment name here
LABEL_RE = re.compile(r"^[a-z0-9-]+/[a-z0-9][a-z0-9-]{1,30}$")
BUSY = set("◐◑◒◓⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏✶✻✽·")
NEEDS_YOU = re.compile(
    r"Do you want to|Would you like to|❯ 1\. Yes|waiting for (the )?user|needs your approval|"
    r"approve (it|this)|permission (prompt|check)",
    re.I,
)


def orca() -> str:
    if IS_MAC:
        return shutil.which("orca") or "/Applications/Orca.app/Contents/Resources/bin/orca"
    env = os.environ.get("ORCA_WSL_CLI_DIR")
    if env and Path(env, "orca-ide").exists():
        return str(Path(env, "orca-ide"))
    found = sorted(glob.glob("/mnt/c/Users/*/AppData/Roaming/orca/wsl-managed-cli/*/orca-ide"),
                   key=os.path.getmtime)
    if not found:
        sys.exit("cb: Orca CLI not found")
    return found[-1]


def run_orca(*args: str, timeout: int = 40) -> str:
    try:
        out = subprocess.run([orca(), *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return ""
    return out.stdout


def env_args(machine: str) -> list[str]:
    return [] if machine == MACHINE else ["--environment", REMOTES[machine]]


def sync(direction: str) -> None:
    """Share the registry through git when it lives in a checkout; a plain dir needs no sync."""
    stamp = Path.home() / ".cache" / "cb-board" / "last-pull"
    if direction == "pull" and stamp.exists() and time.time() - stamp.stat().st_mtime < 45:
        return
    git = ["git", "-C", str(REG)]
    if subprocess.run([*git, "rev-parse", "--is-inside-work-tree"], capture_output=True).returncode != 0:
        return
    run = lambda *a: subprocess.run([*git, *a], capture_output=True, text=True, timeout=60)  # noqa: E731
    if direction == "push":
        run("add", "-A", "--", str(REG))
        # The pathspec commits the registry alone, never whatever else is staged in that checkout.
        run("commit", "-q", "-m", f"cb: {MACHINE} registry", "--", str(REG))
    run("pull", "--rebase", "--autostash", "-q")
    if direction == "push":
        # --no-verify skips the pre-push code review, so only push when every pending
        # commit is a registry edit; anything else waits for a reviewed push.
        top = run("rev-parse", "--show-toplevel").stdout.strip()
        reg = os.path.relpath(REG.resolve(), Path(top).resolve()) if top else "."
        # git runs inside the registry dir, so anchor both pathspecs at the repo root.
        # Pin the commit first so the push sends exactly what was checked, even if the checkout moves.
        sha = run("rev-parse", "HEAD").stdout.strip()
        upstream = run("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}").stdout.strip()
        remote, _, branch = upstream.partition("/")
        # --full-history and -m look at every pending commit, merges included, so a change that
        # was later reverted still counts.
        other = run("log", "--full-history", "-m", "--format=%h", f"{upstream}..{sha}", "--",
                    ":/", f":(top,exclude){reg}")
        if not (sha and remote and branch) or other.returncode != 0 or other.stdout.strip():
            print("cb: registry saved locally; not pushed, because this checkout has unpushed commits outside "
                  "the registry (or no upstream). Push them through the normal review first.", file=sys.stderr)
            return
        # Name the remote and branch; a bare push could follow push.default=matching.
        run("push", "-q", "--no-verify", remote, f"{sha}:refs/heads/{branch}")
    else:
        stamp.parent.mkdir(parents=True, exist_ok=True)
        stamp.touch()


def roster() -> list[dict]:
    REG.mkdir(parents=True, exist_ok=True)
    entries = []
    for f in sorted(REG.glob("*.json")):
        try:
            entries.append(json.loads(f.read_text()))
        except (OSError, json.JSONDecodeError):
            continue
    return entries


def terminals(machine: str) -> dict[str, dict]:
    raw = run_orca("terminal", "list", "--json", *env_args(machine))
    try:
        result = json.loads(raw)["result"]
    except (ValueError, KeyError, TypeError):
        return {}
    rows = result.get("terminals", result) if isinstance(result, dict) else result
    return {t["handle"]: t for t in rows if isinstance(t, dict) and "handle" in t}


def state_of(term: dict | None) -> str:
    if not term or not term.get("connected", True):
        return "gone"
    title = (term.get("title") or "").strip()
    if title[:1] in BUSY:
        return "busy"
    if title[:1] == "✳":
        return "idle"
    return "shell" if not term.get("agentIdentity") else "idle"


def my_terminal() -> str | None:
    return os.environ.get("ORCA_TERMINAL_HANDLE")


def my_label(entries: list[dict]) -> str | None:
    me = my_terminal()
    return next((e["label"] for e in entries if e.get("terminal") == me), None)


def cmd_register(a: argparse.Namespace) -> None:
    if not LABEL_RE.match(a.label) or not a.label.startswith(MACHINE + "/"):
        sys.exit(f"cb: label must look like {MACHINE}/<scope> (lowercase, dashes)")
    term = my_terminal()
    if not term:
        sys.exit("cb: run this inside an Orca terminal (ORCA_TERMINAL_HANDLE is unset)")
    sync("pull")
    for e in roster():
        if e["label"] == a.label and e.get("terminal") != term:
            sys.exit(f"cb: {a.label} is taken by terminal {e.get('terminal')}; cb unregister it first")
        if e.get("terminal") == term and e["label"] != a.label:
            (REG / f"{e['label'].replace('/', '__')}.json").unlink(missing_ok=True)
    entry = {
        "label": a.label, "machine": MACHINE, "terminal": term, "scope": a.scope,
        "session": a.session or "", "registered_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    }
    (REG / f"{a.label.replace('/', '__')}.json").write_text(json.dumps(entry, indent=1) + "\n")
    run_orca("terminal", "rename", "--terminal", term, "--title", a.label)
    sync("push")
    print(f"registered {a.label} -> {term}")


def cmd_unregister(a: argparse.Namespace) -> None:
    sync("pull")
    entries = roster()
    label = a.label or my_label(entries)
    if not label:
        sys.exit("cb: no label given and this terminal is not registered")
    path = REG / f"{label.replace('/', '__')}.json"
    if not path.exists():
        sys.exit(f"cb: {label} is not registered")
    path.unlink()
    sync("push")
    print(f"unregistered {label}")


def live_roster() -> list[dict]:
    entries = roster()
    machines = [MACHINE, *REMOTES]
    with ThreadPoolExecutor(len(machines)) as pool:
        terms = dict(zip(machines, pool.map(terminals, machines)))
    for e in entries:
        e["state"] = state_of(terms.get(e["machine"], {}).get(e.get("terminal")))
        e["title"] = (terms.get(e["machine"], {}).get(e.get("terminal")) or {}).get("title", "")
    registered = {e.get("terminal") for e in entries}
    unregistered = [
        {"machine": m, "terminal": h, "title": t.get("title", ""), "state": state_of(t),
         "agent": t.get("agentIdentity") or "shell"}
        for m, ts in terms.items() for h, t in ts.items() if h not in registered
    ]
    return entries, unregistered


def cmd_who(a: argparse.Namespace) -> None:
    sync("pull")
    entries, unregistered = live_roster()
    if a.json:
        print(json.dumps({"sessions": entries, "unregistered": unregistered}, indent=1))
        return
    for e in sorted(entries, key=lambda e: e["label"]):
        print(f"{e['label']:<24} {e['state']:<5} {e.get('session',''):<15} {e['scope']}")
    if unregistered:
        print(f"\n{len(unregistered)} unregistered terminal(s):")
        for u in unregistered:
            print(f"  {u['machine']}  {u['state']:<5} {u['title'][:60]}")


PROMPT_GLYPHS = ("\u276f", "\u203a")  # Claude Code and Codex input lines
CODEX_GLYPH = "\u203a"
# Empty-box hints, matched against the whole line so a real draft like `Try "pytest" first` still counts.
PLACEHOLDER = re.compile(r'Ask Codex to do anything|Try "[^"]*"')
MENU_OPTION = re.compile(r"\d+\. ")
# Footers of Claude Code question menus and permission prompts (both answer on Enter).
MENU_FOOTERS = ("Enter to select", "Esc to cancel", "to navigate")
# A long paste shows as "[Pasted Content N chars]" (Codex) or "[Pasted text #1 ...]" (Claude):
# its author cannot be told from the screen, so cb never presses Enter on one.
COLLAPSED = re.compile(r"\[Pasted (?:[Cc]ontent|text) ")
PROMPT_WINDOW = 12  # the live input line sits at the bottom; older prompts higher up are history
STUCK = "our earlier message is in the box, not yet submitted"
CLOSED = "terminal closed; waiting for the session to re-register"
RESENT = "[resent: skip it if you already acted on this cb#id] "
QUEUE_DIR = Path.home() / ".cache" / "cb-board" / "queue"
DELIVERY_LOG = Path.home() / ".cache" / "cb-board" / "deferred.log"
POLL_SECONDS = 3
CLEAR_RECHECK_SECONDS = 1.0
SUBMIT_CHECK_SECONDS = 2.0
SUBMIT_TRIES = 3
DRAIN_MAX_SECONDS = 24 * 3600


def _read_input(target: dict) -> tuple[list[str] | None, str]:
    """The target's screen lines and the text in Orca's compose box (never shown on screen)."""
    out = run_orca("terminal", "read", *env_args(target["machine"]), "--terminal", target["terminal"], "--json")
    try:
        term = json.loads(out)["result"]["terminal"]
        return (term.get("tail") or None), (term.get("draft") or "").strip()
    except (ValueError, KeyError, TypeError, AttributeError):
        return None, ""


def _agent_running(target: dict) -> bool | str | None:
    """True/False for an agent in the terminal, CLOSED for a closed terminal, None if unknown."""
    out = run_orca("terminal", "show", *env_args(target["machine"]), "--terminal", target["terminal"], "--json")
    try:
        reply = json.loads(out)
        if (reply.get("error") or {}).get("code") == "terminal_handle_stale":
            return CLOSED
        result = reply["result"]
        return bool((result.get("terminal") or result).get("agentIdentity"))
    except (ValueError, KeyError, TypeError, AttributeError):
        return None


def _input_line(tail: list[str]) -> tuple[int, str] | None:
    for index in range(len(tail) - 1, max(-1, len(tail) - 1 - PROMPT_WINDOW), -1):
        stripped = tail[index].strip()
        if stripped.startswith(PROMPT_GLYPHS):
            return index, stripped[1:].strip()
    return None


def input_state(target: dict, own: str | None = None) -> str | None:
    """None when the target's input box is empty and its agent can take a message; otherwise
    the reason delivery waits. Anything in the box, on the terminal line or in Orca's compose
    box, waits for a person to send it, except our own message `own` (a cb#id), which is STUCK."""
    running = _agent_running(target)
    if running is None or running == CLOSED:
        return running or "screen unreadable"
    if not running:
        return "no agent running in that terminal"
    tail, draft = _read_input(target)
    if tail is None:
        return "screen unreadable"
    found = _input_line(tail)
    if found is None:
        return "no agent prompt on screen"
    index, line = found
    if MENU_OPTION.match(line) and any(f in " ".join(tail[index + 1:]) for f in MENU_FOOTERS):
        return "a question menu is open"
    line = "" if PLACEHOLDER.fullmatch(line) else line
    boxes = [box for box in (draft, line) if box]
    if any(not (own and box.startswith(f"[cb#{own}")) for box in boxes):
        return "someone is typing"  # checked on both surfaces before anything counts as ours
    if boxes:
        return STUCK
    if tail[index].strip().startswith(CODEX_GLYPH) and any("esc to interrupt" in t for t in tail[max(0, index - 4):index]):
        return "codex is mid-turn"  # Claude takes a message mid-turn; Codex waits for its turn to end
    return None


def _on_line(target: dict, ident: str) -> bool | None:
    """True while message cb#ident is still in the box, False once the box is seen without it,
    None when that cannot be told (unreadable screen, or a collapsed paste that hides it)."""
    tail, draft = _read_input(target)
    if tail is None:
        return None
    found = _input_line(tail)
    if found is None:
        return None  # mid-redraw or a long wrapped input: the box cannot be located
    boxes = (draft, found[1])
    if any(box.startswith(f"[cb#{ident}") for box in boxes):
        return True
    if any(COLLAPSED.match(box) for box in boxes):
        return None
    return False


def _press_enter(target: dict) -> None:
    run_orca("terminal", "send", *env_args(target["machine"]), "--terminal", target["terminal"], "--enter")


def deliver(target: dict, text: str, ident: str) -> str:
    """Type and submit in one Orca call; "delivered" only once the box is seen without it,
    "typed" when it reached the terminal but is not yet seen submitted, "unknown" when the receipt
    was lost and it was never seen, "not accepted" when Orca refused and the box is without it."""
    out = run_orca("terminal", "send", *env_args(target["machine"]), "--terminal", target["terminal"],
                   "--text", text, "--enter", "--json")
    try:
        reply = json.loads(out)
        rejected = reply.get("ok") is False or not reply["result"]["send"]["accepted"]
        reached = not rejected
    except (ValueError, KeyError, TypeError, AttributeError):
        rejected = reached = False  # no readable receipt: unknown whether it went through
    if rejected and _on_line(target, ident) is not True:
        return "not accepted"  # Orca said no; only our id on screen would overrule it
    for _ in range(SUBMIT_TRIES):
        time.sleep(SUBMIT_CHECK_SECONDS)
        seen = _on_line(target, ident)
        if seen is False:
            return "delivered" if reached else "unknown"
        if seen:
            reached = True
            if input_state(target, own=ident) == STUCK:
                _press_enter(target)
    return "typed" if reached else "unknown"


class _Lock:
    def __init__(self, path: Path, *, wait: bool = True) -> None:
        self.path, self.wait, self.fh = path, wait, None

    def __enter__(self) -> bool:
        self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.fh = self.path.open("w")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | (0 if self.wait else fcntl.LOCK_NB))
        except BlockingIOError:
            self.fh.close()
            self.fh = None
            return False
        return True

    def __exit__(self, *exc: object) -> None:
        if self.fh:
            fcntl.flock(self.fh, fcntl.LOCK_UN)
            self.fh.close()


def _queue_file(label: str) -> Path:
    return QUEUE_DIR / (re.sub(r"[^A-Za-z0-9_.-]", "_", label) + ".jsonl")


def _queue_rows(path: Path) -> list[dict]:
    rows = []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return rows
    for line in lines:
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if isinstance(row, dict) and row.get("text") and isinstance(row.get("target"), dict):
            rows.append(row)
    return rows


def _queue_edit(path: Path, *, add: dict | None = None, drop: set[str] | None = None,
                mark: set[str] | None = None, **fields: object) -> list[dict]:
    with _Lock(path.with_suffix(".lock")):
        rows = _queue_rows(path)
        if add is not None:
            rows.append(add)
        if drop:
            rows = [r for r in rows if r.get("id") not in drop]
        for r in rows:
            if mark and r.get("id") in mark:
                r.update({k: v for k, v in fields.items() if k != "resend"})
                if fields.get("resend") and RESENT not in r["text"]:
                    r["text"] = r["text"].replace("] ", "] " + RESENT, 1)
        if add is not None or drop or mark:
            tmp = path.with_suffix(".tmp")
            with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as fh:
                fh.writelines(json.dumps(r) + "\n" for r in rows)
            tmp.replace(path)
        return rows


def _log_delivery(note: str) -> None:
    DELIVERY_LOG.parent.mkdir(parents=True, exist_ok=True)
    with DELIVERY_LOG.open("a", encoding="utf-8") as fh:
        fh.write(f"{datetime.now(timezone.utc).isoformat(timespec='seconds')} {note}\n")


def drain(label: str, *, once: bool = False) -> tuple[list[str], str | None]:
    """Deliver everything queued for `label`, oldest first, whenever the box is empty.

    One drainer per label (a lock); several pending messages go out together as one turn.
    Returns the delivery results and, if messages are still waiting, why.
    """
    path = _queue_file(label)
    results: list[str] = []
    started = time.time()
    while True:
        with _Lock(path.with_suffix(".drain"), wait=False) as mine:
            if not mine:
                return results, "another cb delivery for this session is already waiting"
            last_reason = None
            presses = 0
            while True:
                rows = _queue_edit(path)
                if not rows:
                    break
                target = _current_target(label, rows[-1]["target"])
                batch = [r for r in rows if not r.get("typed")]
                typed = [r for r in rows if r.get("typed")]
                if typed and typed[0]["target"] != target and input_state(typed[0]["target"]) == CLOSED:
                    # Typed into a terminal that has since closed. Resend to the new one, tagged, so
                    # a resumed session that did see it can skip the repeat by its cb#id.
                    _queue_edit(path, mark={r["id"] for r in typed}, typed=None, reached=False, target=target, resend=True)
                    _log_delivery(f"resend   {label} ({len(typed)} message(s)): earlier terminal closed")
                    continue
                if typed:
                    # Typed earlier but not seen submitted: wait for the box to show it gone.
                    lead = typed[0]["typed"]
                    seen = _on_line(typed[0]["target"], lead)
                    if seen is False and not typed[0].get("reached") and RESENT not in typed[0]["text"]:
                        # Never seen reaching the terminal (a crash mid-send, or a lost receipt):
                        # send again rather than lose it; the [resent] tag marks a possible repeat.
                        _queue_edit(path, mark={r["id"] for r in typed}, typed=None, resend=True)
                        _log_delivery(f"resend   {label} ({len(typed)} message(s)): earlier attempt unconfirmed")
                        continue
                    if seen is False:
                        _queue_edit(path, drop={r["id"] for r in typed})
                        _log_delivery(f"sent     {label} ({len(typed)} message(s)): "
                                      f"{'submitted after a wait' if typed[0].get('reached') else 'unconfirmed after one resend'}")
                        results.append(f"{len(typed)} message(s) to {label}: delivered")
                        continue
                    reason = "cannot tell yet whether our message was submitted"
                    if seen is None:
                        sync("pull")  # the terminal may have closed and re-registered elsewhere
                        if input_state(typed[0]["target"]) == CLOSED:
                            reason = CLOSED
                    if seen:
                        reason = input_state(typed[0]["target"], own=lead) or STUCK
                    if reason == STUCK and presses < SUBMIT_TRIES:
                        _press_enter(typed[0]["target"])
                        presses += 1
                        time.sleep(SUBMIT_CHECK_SECONDS)
                        continue
                else:
                    reason = input_state(target)
                    if reason is None:
                        time.sleep(CLEAR_RECHECK_SECONDS)  # a second clear read narrows the race with a typist
                        reason = input_state(target)
                    if reason is None:
                        text = " ".join(r["text"] for r in batch)
                        # Record the attempt first, so a crash mid-send is found and resent, never lost.
                        _queue_edit(path, mark={r["id"] for r in batch}, typed=batch[0]["id"], reached=False, target=target)
                        result = deliver(target, text, batch[0]["id"])
                        if result == "delivered":
                            _queue_edit(path, drop={r["id"] for r in batch})
                            _log_delivery(f"sent     {label} ({len(batch)} message(s)): delivered")
                            results.append(f"{len(batch)} message(s) to {label}: delivered")
                            continue
                        if result in ("typed", "unknown"):
                            _queue_edit(path, mark={r["id"] for r in batch}, reached=result == "typed")
                            presses = SUBMIT_TRIES  # deliver() already pressed Enter that many times
                            continue
                        _queue_edit(path, mark={r["id"] for r in batch}, typed=None)
                        reason = "orca did not accept the send"
                    if reason == CLOSED:
                        sync("pull")  # pick up a re-registration from the other machine
                if reason != last_reason:
                    _log_delivery(f"waiting  {label} ({len(rows)} queued): {reason}")
                    last_reason = reason
                if once or time.time() - started > DRAIN_MAX_SECONDS:
                    return results, reason
                time.sleep(POLL_SECONDS)
        # A message queued while this drainer was finishing found the lock held: look again.
        if not _queue_edit(path):
            return results, None


def _current_target(label: str, fallback: dict) -> dict:
    """Where `label` points in the registry now, so a re-registered session gets its messages."""
    entry = next((e for e in roster() if e.get("label") == label and e.get("terminal")), None)
    return {"machine": entry["machine"], "terminal": entry["terminal"]} if entry else fallback


def _spawn_drainer(label: str) -> None:
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "send", "--drain", label],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def cmd_send(a: argparse.Namespace) -> None:
    if a.drain:
        drain(a.label)
        return
    if not a.message:
        sys.exit("cb: nothing to send.")
    sync("pull")
    entries, _ = live_roster()
    target = next((e for e in entries if e["label"] == a.label), None)
    if not target:
        sys.exit(f"cb: no session is registered as {a.label}; run `cb who`. Not sent.")
    if target["state"] in ("gone", "shell"):
        sys.exit(f"cb: {a.label}'s terminal is {'gone' if target['state'] == 'gone' else 'a shell with no agent'}; "
                 f"ask it to re-register. Not sent.")
    sender = my_label(entries) or f"{MACHINE}/unregistered"
    ident = secrets.token_hex(3)
    text = f"[cb#{ident} from {sender} to {a.label}] " + " ".join(a.message)
    _queue_edit(_queue_file(a.label), add={"id": ident, "label": a.label, "text": text, "at": time.time(),
                                           "target": {"machine": target["machine"], "terminal": target["terminal"]}})
    results, waiting = drain(a.label, once=True)
    for line in results:
        print(f"cb: {line}")
    if waiting:
        _spawn_drainer(a.label)
        print(f"cb: queued for {a.label} ({waiting}); it goes out, in order, as soon as the box is empty. "
              f"`cb queue` shows what is waiting.")


def cmd_queue(a: argparse.Namespace) -> None:
    if a.drop:
        for path in QUEUE_DIR.glob("*.jsonl"):
            _queue_edit(path, drop={a.drop.removeprefix("cb#")})
        print(f"cb: dropped {a.drop} if it was queued")
        return
    pending = [(p, _queue_rows(p)) for p in sorted(QUEUE_DIR.glob("*.jsonl"))]
    pending = [(p, rows) for p, rows in pending if rows]
    if not pending:
        print("cb: nothing queued")
        return
    for path, rows in pending:
        label = rows[0].get("label") or path.stem
        reason = input_state(rows[0]["target"]) or "box is empty; delivering"
        print(f"{label}: {len(rows)} waiting ({reason})")
        for r in rows:
            print(f"  cb#{r['id']}  {int((time.time() - r.get('at', time.time())) // 60)}m ago  {r['text'][:90]}")
        with _Lock(path.with_suffix(".drain"), wait=False) as free:
            stalled = free
        if stalled:
            _spawn_drainer(label)  # nobody was delivering this queue (e.g. after a reboot)


# ---------------------------------------------------------------- board
STATE: dict = {"generated_at": None, "sessions": [], "unregistered": [], "prs": [], "runs": {}, "edges": []}
# Sealed run history per machine. The peer folder is a read-only mirror (rsync), never merged.
RUN_DIRS = {m: Path(d).expanduser() for m, d in CFG.get("runs", {}).items()}
_RUN_CACHE: dict[str, tuple[float, dict]] = {}
EDGE_FILE = Path.home() / ".cache" / "cb-board" / "edges.json"
INCOMING = re.compile(r"Message from @([a-z0-9-]+)")
OUTGOING = re.compile(r"→ sent to ([a-z0-9-]+)")
CROSS = re.compile(r"\[(?:cb(?:#[0-9a-f]{6})? from ([a-z0-9-]+/[a-z0-9-]+)|From ([a-z0-9-]+))")


def run_summary(path: Path) -> dict:
    mtime = path.stat().st_mtime
    hit = _RUN_CACHE.get(str(path))
    if hit and hit[0] == mtime:
        return hit[1]
    try:
        m = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    inv = m.get("invocation_id") or path.stem
    grade = None
    for g in sorted((path.parent / "grades" / inv).glob("circuit-rubric-*.json")):
        try:
            gd = json.loads(g.read_text())
            grade = {"total": gd.get("total"), "failed": bool(gd.get("gate_failures")), "headline": gd.get("headline"),
                     "kind": gd.get("kind")}
        except (OSError, ValueError):
            pass
    failure = ""
    for st in m.get("stages") or []:
        if isinstance(st, dict) and st.get("failure"):
            failure = f"{st.get('name')}: {(st['failure'].get('summary') or '')[:160]}"
            break
    out = {"invocation_id": inv, "status": m.get("status"), "book": m.get("requested_book"),
           "started_at": m.get("started_at"), "duration_s": m.get("duration_seconds"),
           "kind": (grade or {}).get("kind") or ("replay" if m.get("replay") else "live"),
           "grade": grade, "failure": failure}
    _RUN_CACHE[str(path)] = (mtime, out)
    return out


def poll_runs() -> dict:
    runs = {}
    for machine, d in RUN_DIRS.items():
        if not d.is_dir():
            runs[machine] = {"available": False, "items": []}
            continue
        files = sorted((p for p in d.glob("2*.json")), key=lambda p: p.stat().st_mtime, reverse=True)[:10]
        runs[machine] = {"available": True, "items": [s for s in map(run_summary, files) if s]}
    return runs


def load_edges() -> dict:
    try:
        return json.loads(EDGE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def update_edges(edges: dict, sessions: list[dict]) -> dict:
    by_session = {s.get("session"): s["label"] for s in sessions if s.get("session")}
    name = lambda n: by_session.get(n, n)  # noqa: E731
    now = datetime.now(timezone.utc).isoformat(timespec="seconds")
    for s in sessions:
        me = s["label"]
        for line in (s.get("screen") or "").splitlines():
            pairs = []
            if (m := INCOMING.search(line)):
                pairs.append((name(m.group(1)), me))
            if (m := OUTGOING.search(line)):
                pairs.append((me, name(m.group(1))))
            if (m := CROSS.search(line)):
                pairs.append((m.group(1) or name(m.group(2)), me))
            for src, dst in pairs:
                if src == dst:
                    continue
                key = f"{src}|{dst}"
                e = edges.setdefault(key, {"src": src, "dst": dst, "seen": [], "first": now})
                sig = line.strip()[:90]
                if sig not in e["seen"]:
                    e["seen"] = (e["seen"] + [sig])[-20:]
                    e["last"] = now
                    e["snippet"] = sig
    EDGE_FILE.parent.mkdir(parents=True, exist_ok=True)
    EDGE_FILE.write_text(json.dumps(edges))
    return edges


def recap_of(screen: str) -> str:
    lines = screen.splitlines()
    for i in range(len(lines) - 1, -1, -1):
        if "recap:" in lines[i]:
            text = [lines[i].split("recap:", 1)[1].strip()]
            for nxt in lines[i + 1:i + 4]:
                if nxt.startswith("  ") and nxt.strip() and not nxt.strip()[0] in "⏺❯›─✻※":
                    text.append(nxt.strip())
                else:
                    break
            return " ".join(text)
    return ""


def clean_screen(raw: str) -> str:
    keep = [ln for ln in raw.splitlines()
            if not re.match(r"^(source|cursor|oldest cursor|latest cursor):", ln) and "─────" not in ln]
    return "\n".join(keep).strip()


def poll_session(e: dict) -> dict:
    if e["state"] == "gone":
        return {**e, "recap": "", "needs_you": False, "screen": ""}
    raw = run_orca("terminal", "read", *env_args(e["machine"]), "--terminal", e["terminal"], "--limit", "60")
    screen = clean_screen(raw)
    tail = "\n".join(screen.splitlines()[-14:])
    return {**e, "recap": recap_of(screen), "needs_you": bool(NEEDS_YOU.search(tail)), "screen": screen}


def poll_prs() -> list[dict]:
    if not CFG.get("prs_repo"):
        return []
    try:
        out = subprocess.run(
            ["gh", "pr", "list", "--repo", CFG["prs_repo"], "--state", "open", "--limit", "30",
             "--json", "number,title,headRefName,isDraft,mergeable,statusCheckRollup,updatedAt"],
            capture_output=True, text=True, timeout=60).stdout
        prs = json.loads(out)
    except (subprocess.TimeoutExpired, ValueError, OSError):
        return STATE["prs"]
    for p in prs:
        checks = p.pop("statusCheckRollup", None) or []
        states = {(c.get("conclusion") or c.get("status") or "").lower() for c in checks}
        p["ci"] = ("none" if not checks else "fail" if states & {"failure", "cancelled", "timed_out"}
                   else "pending" if states & {"in_progress", "queued", "pending", ""} else "pass")
    return prs


def poll_loop(interval: int) -> None:
    last_pr = 0.0
    edges = load_edges()
    while True:
        try:
            sync("pull")
            entries, unregistered = live_roster()
            with ThreadPoolExecutor(6) as pool:
                sessions = list(pool.map(poll_session, entries))
            if time.time() - last_pr > 120:
                STATE["prs"] = poll_prs()
                last_pr = time.time()
            edges = update_edges(edges, sessions)
            STATE.update(sessions=sessions, unregistered=unregistered, runs=poll_runs(),
                         edges=sorted(({k: v for k, v in e.items() if k != "seen"} | {"count": len(e["seen"])}
                                       for e in edges.values()), key=lambda e: e.get("last", ""), reverse=True),
                         generated_at=datetime.now(timezone.utc).isoformat(timespec="seconds"))
            STATE.pop("error", None)
        except Exception as err:  # the board must keep serving its last good state
            STATE["error"] = repr(err)
        time.sleep(interval)


PAGE = Path(__file__).resolve().parent.parent / "board" / "cb-board.html"


TOKEN: str | None = None  # set by --lan: the board shows every session's screen, so off-box readers need it


class Handler(BaseHTTPRequestHandler):
    def _authorized(self) -> bool:
        if TOKEN is None:
            return True
        query = self.path.partition("?")[2]
        cookie = self.headers.get("Cookie") or ""
        return f"token={TOKEN}" in query.split("&") or f"cbtoken={TOKEN}" in cookie.replace(" ", "").split(";")

    def do_GET(self) -> None:
        if not self._authorized():
            self.send_error(403, "cb board: open the URL with the ?token= printed at startup")
            return
        route = self.path.partition("?")[0]
        if route == "/state.json":
            body, ctype = json.dumps(STATE).encode(), "application/json"
        elif route in ("/", "/index.html"):
            body, ctype = PAGE.read_bytes(), "text/html; charset=utf-8"
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        if TOKEN is not None:  # the page's own state.json fetches carry the token as a cookie
            self.send_header("Set-Cookie", f"cbtoken={TOKEN}; HttpOnly; SameSite=Strict; Path=/")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args) -> None:
        pass


def cmd_board(a: argparse.Namespace) -> None:
    global TOKEN
    host, url = "127.0.0.1", f"http://localhost:{a.port}/"
    if a.lan:  # e.g. WSL -> the Windows browser, or another machine: token-gated
        TOKEN = secrets.token_urlsafe(16)
        host, url = "0.0.0.0", f"http://localhost:{a.port}/?token={TOKEN}"
    threading.Thread(target=poll_loop, args=(a.interval,), daemon=True).start()
    print(f"cb board on {url} (polling every {a.interval}s)")
    ThreadingHTTPServer((host, a.port), Handler).serve_forever()


def main() -> None:
    p = argparse.ArgumentParser(prog="cb", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("register"); r.add_argument("label"); r.add_argument("--scope", required=True)
    r.add_argument("--session"); r.set_defaults(fn=cmd_register)
    u = sub.add_parser("unregister"); u.add_argument("label", nargs="?"); u.set_defaults(fn=cmd_unregister)
    w = sub.add_parser("who"); w.add_argument("--json", action="store_true"); w.set_defaults(fn=cmd_who)
    s = sub.add_parser("send"); s.add_argument("label"); s.add_argument("message", nargs="*")
    s.add_argument("--drain", action="store_true", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_send)
    q = sub.add_parser("queue"); q.add_argument("--drop", metavar="ID", help="cancel one queued message")
    q.set_defaults(fn=cmd_queue)
    b = sub.add_parser("board"); b.add_argument("--port", type=int, default=8765)
    b.add_argument("--interval", type=int, default=30)
    b.add_argument("--lan", action="store_true", help="listen on all interfaces, gated by a printed token")
    b.set_defaults(fn=cmd_board)
    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
