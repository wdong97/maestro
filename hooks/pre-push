#!/usr/bin/env bash
# maestro pre-push: peer-review the push before it goes out. Portable — calls
# `ensemble` from PATH (installed by maestro install.sh), no hardcoded paths.
#
# Bypass once with:  ENSEMBLE_REVIEW=0 git push
# Reviewer:          ENSEMBLE_REVIEWER=claude|codex|both
# Time budget:       ENSEMBLE_REVIEW_TIMEOUT=600   (seconds)
#
# This gate used to fail in both directions at once, and did on 27 Aug 2026:
#
#   - The y/N prompt was conditional on a TTY, so anywhere without one — an agent, a
#     script, a non-interactive shell — the review printed its findings and the push
#     proceeded regardless. A review that found five P2 issues shipped all five to
#     production, on a repo where main auto-deploys.
#   - The review ran unbounded in front of the push, so a slow review did not delay a
#     push, it killed it. Three pushes in a row died that way and the work sat unpushed.
#
# So: a clean review asks nothing and gets out of the way. A review with findings gates —
# prompting where it can, refusing where it cannot. A review that cannot finish also
# refuses, because "reviewed and clean" and "never reviewed" must not look alike from the
# outside. Every refusal names the way through.
#
# "Clean" is a positive signal, never an absence: the reviewer must end with an explicit
# VERDICT line. Output with no verdict is unreadable, not passing, and is refused too.

set -u

# timeout(1) is GNU coreutils — absent from a stock macOS, which this repo supports.
# Prefer it, then Homebrew's gtimeout, then do it ourselves. Exit 124 = timed out,
# matching timeout(1) so the caller has one contract.
ensemble_with_timeout() {
  local budget="$1"; shift
  if command -v timeout >/dev/null 2>&1; then timeout "$budget" "$@"; return $?; fi
  if command -v gtimeout >/dev/null 2>&1; then gtimeout "$budget" "$@"; return $?; fi
  # Job control gives the child its own process group, so the whole tree can be
  # signalled: `ensemble` spawns codex/claude, and killing the shell alone would
  # leave those running and billing after we have given up on them.
  local pid waited=0
  set -m
  "$@" &
  pid=$!
  set +m
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$waited" -ge "$budget" ]; then
      kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
      sleep 2
      kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
      return 124
    fi
    sleep 1
    waited=$((waited + 1))
  done
  wait "$pid"
}

# What is actually being pushed. git feeds pre-push one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# with an all-zero sha where a ref does not exist on that side. Ask git rather than
# guessing from @{u}: pushing a branch you are not standing on, or a branch for the
# first time, both review the wrong thing (or nothing) if you guess.
#
# Prints one "old..new" range per ref, and returns:
#   0 = ranges on stdout | 2 = only deletions, nothing to review | 1 = could not tell
ensemble_push_ranges() {
  local refs="$1" remote="${2:-origin}"
  # Derive both ids from the repo instead of hardcoding SHA-1 constants: a SHA-256 repo
  # has longer ids, and the empty tree must actually exist here for `git diff` to use it.
  local empty_tree zero
  empty_tree="$(git hash-object -w -t tree /dev/null 2>/dev/null)"
  zero="$(printf '%s' "${empty_tree:-0000000000000000000000000000000000000000}" | tr '[:alnum:]' '0')"
  local lref lsha rref rsha base saw_any=0 emitted=0
  while read -r lref lsha rref rsha; do
    [ -n "${lsha:-}" ] || continue
    saw_any=1
    [ "$lsha" = "$zero" ] && continue                    # deleting a ref: nothing to review
    if [ -n "${rsha:-}" ] && [ "$rsha" != "$zero" ]; then
      base="$rsha"                                       # they have it: review old -> new
    else
      # New ref over there. Ask the remote what it ACTUALLY has rather than trusting
      # refs/remotes/*, which goes stale the moment a remote is repointed or rewritten —
      # and a stale anchor silently excludes history the destination has never seen.
      # Ask the destination we are actually pushing to: git hands the hook the remote's
      # push URL in $2, and .pushurl can differ from .url — anchoring on the fetch remote
      # would exclude commits the destination has never seen. Bounded: a stalled or huge
      # remote must not hang the hook before the review even starts.
      local candidate best="" dest="${ENSEMBLE_PUSH_URL:-$remote}"
      for candidate in $(ensemble_with_timeout 20 git ls-remote --heads --tags "$dest" 2>/dev/null \
                           | awk '{print $1}' | head -n 200); do
        git cat-file -e "$candidate^{commit}" 2>/dev/null || continue   # only what we hold
        git merge-base --is-ancestor "$candidate" "$lsha" 2>/dev/null || continue
        # keep the furthest-along ancestor: the least history the remote already has
        if [ -z "$best" ] || git merge-base --is-ancestor "$best" "$candidate" 2>/dev/null; then
          best="$candidate"
        fi
      done
      if [ -n "$best" ]; then
        base="$best"
      else
        # Could not confirm anything shared (offline, empty remote, unrelated history):
        # review the ref's whole history. Over-reviewing is the safe direction.
        base="$empty_tree"
      fi
    fi
    echo "$base..$lsha"
    emitted=1
  done <<REFS
$refs
REFS
  [ "$emitted" = 1 ] && return 0
  [ "$saw_any" = 1 ] && return 2
  return 1
}

# Count the standalone verdict lines in one reviewer run, per reviewer section.
# Prints "<verdicts> <holds>". A verdict is a line of its own — reviews of this hook
# quote "VERDICT: HOLD" mid-sentence, and prose about a verdict is not a verdict.
# Within a section the last one wins, so a reviewer that thinks aloud is read by its
# conclusion.
ensemble_count_verdicts() {
  awk '
    { up = toupper($0) }
    up ~ /^=+[[:space:]]*(CODEX|CLAUDE)[[:space:]]+REVIEW/ { sec++; next }
    up ~ /^[[:space:]]*VERDICT:[[:space:]]*(SHIP|HOLD)[[:space:]]*$/ {
      v = up; sub(/^[[:space:]]*VERDICT:[[:space:]]*/, "", v); sub(/[[:space:]]*$/, "", v)
      seen[sec ? sec : 1] = v }
    END { n = 0; hold = 0
          for (i in seen) { n++; if (seen[i] == "HOLD") hold++ }
          printf "%d %d\n", n, hold }' "$1"
}

ensemble_review_gate() {
  if ! command -v ensemble >/dev/null 2>&1; then
    echo "[ensemble] 'ensemble' not on PATH — skipping review (run maestro install.sh)" >&2
    return 0
  fi

  local upstream selectors budget output status reply ranges ranges_rc reviewer
  ranges="$(ensemble_push_ranges "${ENSEMBLE_PUSH_REFS:-}" "${ENSEMBLE_PUSH_REMOTE:-origin}")"
  ranges_rc=$?
  if [ "$ranges_rc" -eq 2 ]; then
    echo "[ensemble] push deletes refs only — nothing to review." >&2
    return 0
  fi
  if [ "$ranges_rc" -eq 0 ] && [ -n "$ranges" ]; then
    selectors="$(printf '%s\n' "$ranges" | sed 's/^/--range /')"
  else
    upstream="$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)"
    selectors="--uncommitted"
    [ -n "$upstream" ] && selectors="--base $upstream"
  fi
  budget="${ENSEMBLE_REVIEW_TIMEOUT:-600}"
  reviewer="${ENSEMBLE_REVIEWER:-codex}"
  if ! output="$(mktemp -t ensemble-review.XXXXXX)"; then
    cat >&2 <<EOF
[ensemble] could not create a file to capture the review — push refused.
[ensemble] No review can be read, and unread is not clean.
[ensemble] bypass deliberately with:  ENSEMBLE_REVIEW=0 git push
EOF
    return 1
  fi

  # Every pushed ref gets its own review, and each is judged ON ITS OWN. Counting
  # verdicts across the whole file lets a chatty review of one range cover for another
  # that never ran.
  : >"$output"
  status=0
  local one chunk per_call chunk_counts n h short=0 findings=0 held=0
  per_call=1; [ "$reviewer" = both ] && per_call=2
  while IFS= read -r one; do
    [ -n "$one" ] || continue
    echo "[ensemble] peer-reviewing push ($one, up to ${budget}s)..." >&2
    if ! chunk="$(mktemp -t ensemble-review-part.XXXXXX)"; then short=1; break; fi
    # shellcheck disable=SC2086  # the selector is deliberately two words
    ensemble_with_timeout "$budget" ensemble review $one --by "$reviewer" >"$chunk" 2>&1
    status=$?
    cat "$chunk" >>"$output"
    if [ "$status" -eq 124 ]; then rm -f "$chunk"; break; fi
    if [ "$status" -ne 0 ]; then
      # A review that printed a verdict and then died has not reviewed anything. Its
      # exit status outranks anything it managed to say first.
      echo "[ensemble] $one: the review exited $status — not a completed review" >&2
      short=1
    fi
    chunk_counts="$(ensemble_count_verdicts "$chunk")"
    n="${chunk_counts%% *}"; h="${chunk_counts##* }"
    if [ "$n" -lt "$per_call" ]; then
      echo "[ensemble] $one answered with $n of $per_call verdict(s)" >&2
      short=1
    fi
    [ "$h" -gt 0 ] && held=1
    grep -qE '^[[:space:]]*-?[[:space:]]*\[P[0-9]\]' "$chunk" && findings=1
    rm -f "$chunk"
  done <<SELECTORS
$selectors
SELECTORS
  cat "$output" >&2

  if [ "$status" -eq 124 ]; then
    rm -f "$output"
    cat >&2 <<EOF

[ensemble] review did not finish within ${budget}s — push refused.
[ensemble] A push that outran its review is not a reviewed push.
[ensemble]   raise the budget:  ENSEMBLE_REVIEW_TIMEOUT=1200 git push
[ensemble]   or review first:   ensemble review --base ${ENSEMBLE_PUSH_REMOTE:-origin}/HEAD
[ensemble]   then push:         ENSEMBLE_REVIEW=0 git push
EOF
    return 1
  fi

  # Each range answered for itself above. What is left is to act on the tally:
  #   short    — some range produced fewer verdicts than reviewers asked; unreadable,
  #              and unreadable is not clean
  #   held     — a reviewer said HOLD; any HOLD beats every SHIP
  #   findings — a "[P#]" marker anywhere means there is something to fix
  rm -f "$output"

  if [ "$short" -eq 1 ]; then
    cat >&2 <<EOF

[ensemble] a pushed range came back without a verdict from every reviewer — push refused.
[ensemble] A reviewer that answered nothing has not approved anything.
[ensemble]   re-run:  ensemble review --base ${ENSEMBLE_PUSH_REMOTE:-origin}/HEAD
[ensemble]   or push: ENSEMBLE_REVIEW=0 git push
EOF
    return 1
  fi

  if [ "$findings" -eq 0 ] && [ "$held" -eq 0 ]; then
    echo "[ensemble] review clean (VERDICT: SHIP) — pushing." >&2
    return 0
  fi

  if [ -t 1 ] && [ -e /dev/tty ]; then
    printf '\n[ensemble] review says %s. push anyway? [y/N] ' \
      "$([ "$findings" -eq 1 ] && echo "there are findings" || echo "HOLD")" >&2
    read -r reply </dev/tty
    case "$reply" in
      y | Y | yes | YES) return 0 ;;
      *)
        echo "[ensemble] push aborted." >&2
        return 1
        ;;
    esac
  fi

  cat >&2 <<EOF

[ensemble] review did not pass and there is no terminal to confirm on — push refused.
[ensemble] Fix them, or push deliberately with:  ENSEMBLE_REVIEW=0 git push
EOF
  return 1
}

# stdin can only be read once, and the classic hook we may chain to wants it too.
ENSEMBLE_PUSH_REFS="$(cat)"
ENSEMBLE_PUSH_REMOTE="${1:-origin}"
ENSEMBLE_PUSH_URL="${2:-}"          # the push destination, which may differ from .url
export ENSEMBLE_PUSH_REFS ENSEMBLE_PUSH_REMOTE ENSEMBLE_PUSH_URL

if [ "${ENSEMBLE_REVIEW:-1}" != 0 ]; then
  ensemble_review_gate || exit 1
fi

# Chain to a repo-local classic hook if one exists (so global install never
# silently disables a repo's own pre-push). Guarded against calling itself.
CLASSIC="$(git rev-parse --absolute-git-dir 2>/dev/null)/hooks/pre-push"
SELF_RP="$(readlink -f "$0" 2>/dev/null || echo "$0")"
CLASSIC_RP="$(readlink -f "$CLASSIC" 2>/dev/null || echo "$CLASSIC")"
if [ -x "$CLASSIC" ] && [ "$CLASSIC_RP" != "$SELF_RP" ]; then
  exec "$CLASSIC" "$@" <<REFS
$ENSEMBLE_PUSH_REFS
REFS
fi
exit 0
